# Copy this to /opt/investment-agent/.env on the ECS host, then replace every placeholder.
# Do not commit the populated file or TLS files.
COMPOSE_PROJECT_NAME=investment-agent
APP_ENV=production

POSTGRES_DB=investment_agent
POSTGRES_USER=investment_agent
POSTGRES_PASSWORD=replace-with-a-unique-32-character-password
DATABASE_URL=postgresql://investment_agent:replace-with-url-encoded-password@postgres:5432/investment_agent
REDIS_URL=redis://redis:6379/0

SERVER_NAME=aiinvestmentagent.cn
WWW_SERVER_NAME=www.aiinvestmentagent.cn
CORS_ORIGINS=https://aiinvestmentagent.cn,https://www.aiinvestmentagent.cn
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_AUTH_MODE=oidc
TLS_CERT_FILE=/opt/investment-agent/certs/aiinvestmentagent.cn.pem
TLS_KEY_FILE=/opt/investment-agent/certs/aiinvestmentagent.cn.key

# Values copied from Alibaba Cloud IDaaS OIDC discovery/application settings.
OIDC_ISSUER=https://replace-with-your-idaas-issuer
OIDC_AUDIENCE=replace-with-your-idaas-api-audience
OIDC_JWKS_URL=https://replace-with-your-idaas-jwks-url
OIDC_ACCESS_TOKEN_TYPES=access,at+jwt
NEXT_PUBLIC_OIDC_AUTHORITY=https://replace-with-your-idaas-issuer
NEXT_PUBLIC_OIDC_CLIENT_ID=replace-with-your-idaas-public-client-id
NEXT_PUBLIC_OIDC_SCOPE=openid profile email agent:run
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=replace-with-a-random-workspace-id
