# Copy to a local file outside version control, then pass it with --env-file.
# These values are for local Docker Compose development only.
APP_ENV=development
POSTGRES_DB=investment_agent
POSTGRES_USER=investment_agent
POSTGRES_PASSWORD=change-me-development-only
DATABASE_URL=postgresql://investment_agent:change-me-development-only@postgres:5432/investment_agent
REDIS_URL=redis://redis:6379/0
VECTOR_STORE=pgvector
VECTOR_DB_NAME=investment_vectors
VECTOR_DB_USER=investment_vectors
VECTOR_DB_PASSWORD=change-me-vector-development-only
VECTOR_DB_URL=postgresql://investment_vectors:change-me-vector-development-only@vector-db:5432/investment_vectors
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_DEVELOPMENT_PRINCIPAL_ID=local-user
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=local-workspace
BACKEND_IMAGE=investment-agent-backend:local
FRONTEND_IMAGE=investment-agent-frontend:local
