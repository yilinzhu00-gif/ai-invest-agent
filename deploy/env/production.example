# Copy to a secret-managed local file. Do not use these placeholders in production.
APP_ENV=production
POSTGRES_DB=replace-with-database-name
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-a-unique-secret-from-your-secret-manager
DATABASE_URL=postgresql://replace-with-database-user:replace-with-a-unique-secret-from-your-secret-manager@postgres:5432/replace-with-database-name
VECTOR_DB_NAME=replace-with-vector-database-name
VECTOR_DB_USER=replace-with-vector-database-user
VECTOR_DB_PASSWORD=replace-with-vector-database-secret
VECTOR_DB_URL=postgresql://replace-with-vector-database-user:replace-with-vector-database-secret@vector-db:5432/replace-with-vector-database-name
CORS_ORIGINS=https://app.example.invalid
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid
NEXT_PUBLIC_AUTH_MODE=oidc
NEXT_PUBLIC_OIDC_AUTHORITY=https://idp.example.invalid
NEXT_PUBLIC_OIDC_CLIENT_ID=replace-with-public-oidc-client-id
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=replace-with-workspace-id
OIDC_ISSUER=https://idp.example.invalid/
OIDC_AUDIENCE=replace-with-api-audience
OIDC_JWKS_URL=https://idp.example.invalid/.well-known/jwks.json
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-secret
# CI replaces these immutable image references during deployment.
BACKEND_IMAGE=ghcr.io/replace-with-owner/investment-agent-backend:replace-with-commit-sha
FRONTEND_IMAGE=ghcr.io/replace-with-owner/investment-agent-frontend:replace-with-commit-sha
