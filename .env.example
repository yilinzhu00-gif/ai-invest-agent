# ===== 复制本文件为 .env 并填入你的真实信息 =====

# 方案 A：用 OpenAI
OPENAI_API_KEY=sk-你的key
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
REVIEW_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# 受控 Agent / 文档 worker（开发期默认不启用 OCR/VLM）
AGENT_RUNTIME=langgraph
AGENT_MAX_STEPS=8
AGENT_MAX_REVISIONS=1
# 默认 deterministic：不调用模型，只能输出所给证据的保守摘录。
# 要实际调用上面的 OpenAI-compatible 服务，显式设为 openai_compatible。
AGENT_EXECUTION_MODE=deterministic
AGENT_MODEL_TIMEOUT_SECONDS=60
# Celery 仅对显式瞬时错误（含 run_timeout）重试；耗尽后转为人工恢复。
AGENT_RUN_MAX_RETRIES=3
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_MAX_PAGES=500
DOCUMENT_OCR_LANGUAGES=chi_sim+eng
DOCUMENT_TABLE_MERGE_THRESHOLD=0.90

# 方案 B：用国内服务（示例 DeepSeek，把上面注释掉、用下面这组）
# 注意：DeepSeek 的 chat 走自家接口，embedding 需另选支持 embedding 的服务
# OPENAI_API_KEY=你的key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# CHAT_MODEL=deepseek-chat
# EMBED_MODEL=text-embedding-3-small

# 方案 C：用通义千问 / 智谱等 —— 把 base_url、模型名换成对应服务文档里的值即可
